# Copie este archivo como .env y complete los valores. El archivo .env nunca se sube al repositorio.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/marketradar
DB_USUARIO=marketradar
DB_CLAVE=cambie_esta_clave

# Modo desarrollo: muestra detalle técnico en los errores (false en producción)
MODO_DESARROLLO=true
CORS_ORIGENES=http://localhost:8080

# Administrador inicial: se crea al arrancar si no existe. La clave debe tener mayúscula,
# minúscula, número y carácter especial, y no puede contener el correo.
ADMIN_CORREO=
ADMIN_CLAVE=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Marketradar

# Tasa de respaldo (COP por dólar) y su fecha. Solo se usa si la TRM del día no se puede consultar
# y no hay ninguna guardada en la base de datos.
TASA_USD_COP=
FECHA_TASA=

# AliExpress (Open Platform, programa de afiliados)
ALIEXPRESS_HABILITADO=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Shopify (Catalog API o Storefront MCP: por decidir)
SHOPIFY_HABILITADO=false
SHOPIFY_TOKEN=

# Mercado Libre Colombia (OAuth)
MERCADOLIBRE_HABILITADO=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# Asistente de IA con Spring AI. Por defecto Gemini (clave gratuita en https://aistudio.google.com/apikey).
# Para apagarlo: ASISTENTE_PROVEEDOR=ninguno
ASISTENTE_PROVEEDOR=spring-ai
ASISTENTE_API_KEY=
ASISTENTE_MODELO=gemini-2.5-flash
# Solo para usar OpenAI en lugar de Gemini:
# ASISTENTE_URL_BASE=https://api.openai.com
# ASISTENTE_RUTA=/v1/chat/completions
