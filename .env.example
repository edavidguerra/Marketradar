# Copie este archivo como .env y complete los valores. El archivo .env nunca se sube al repositorio.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/marketradar
DB_USUARIO=marketradar
DB_CLAVE=cambie_esta_clave

# Modo desarrollo: muestra detalle técnico en los errores (false en producción)
MODO_DESARROLLO=true
CORS_ORIGENES=http://localhost:8080

# Administrador inicial: se crea al arrancar si no existe. La clave debe tener mayúscula,
# minúscula, número y carácter especial, y no puede contener el correo.
ADMIN_CORREO=
ADMIN_CLAVE=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Marketradar

# Tasa de respaldo (COP por dólar) y su fecha. Solo se usa si la TRM del día no se puede consultar
# y no hay ninguna guardada en la base de datos.
TASA_USD_COP=
FECHA_TASA=

# AliExpress (Open Platform, programa de afiliados). Ver docs/integraciones/aliexpress.md
ALIEXPRESS_HABILITADO=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Shopify (Global Catalog por MCP). Ver docs/integraciones/shopify.md
SHOPIFY_HABILITADO=false
SHOPIFY_TOKEN=

# Mercado Libre Colombia (OAuth). El refresh token se obtiene una vez con el flujo de autorización
# (ver docs/integraciones/mercadolibre.md). Después el backend lo renueva solo y guarda el nuevo en la base de datos
# (tabla credencial_marketplace). Para guardarlo en un archivo, ponga la ruta en MERCADOLIBRE_ARCHIVO_TOKEN.
MERCADOLIBRE_HABILITADO=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=

# Google Shopping con SerpApi: precios reales de muchas tiendas colombianas. La clave se crea gratis en
# https://serpapi.com (250 búsquedas al mes). Ver docs/integraciones/google-shopping.md
SERPAPI_HABILITADO=false
SERPAPI_API_KEY=

# Búsqueda con IA (Gemini, plan gratis de Google AI Studio): entiende lo que se busca, deja solo los productos
# que sí son lo buscado y escribe un resumen. La clave se crea en https://aistudio.google.com/apikey
# (ver docs/integraciones/gemini.md). Sin clave, la búsqueda funciona con los filtros propios.
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.5-flash-lite

# Asistente de IA con Claude. La clave se crea en https://console.anthropic.com (ver docs/asistente-claude.md).
# Para apagarlo: ASISTENTE_PROVEEDOR=ninguno
ASISTENTE_PROVEEDOR=claude
ASISTENTE_API_KEY=
ASISTENTE_MODELO=claude-opus-5-5

# Seguir productos: correos por SMTP (ver docs/seguimientos.md). Sin SMTP_HOST y CORREO_REMITENTE no se manda
# ningún correo: los seguimientos se guardan, pero los avisos quedan pendientes. Nunca se finge un envío.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_STARTTLS=true
SMTP_SSL=false
CORREO_REMITENTE=
CORREO_NOMBRE_REMITENTE=Marketradar
# Dirección pública para los enlaces de los correos (en Render se toma sola de RENDER_EXTERNAL_URL).
URL_PUBLICA=http://localhost:8080
# Revisión de precios: cada cuánto se revisa cada producto (mínimo 30) y cuántas consultas a tiendas por ronda.
SEGUIMIENTOS_HABILITADO=true
SEGUIMIENTOS_FRECUENCIA_MINUTOS=720
SEGUIMIENTOS_REVISAR_CADA_MINUTOS=15
SEGUIMIENTOS_CONSULTAS_POR_RONDA=5
SEGUIMIENTOS_BAJA_MINIMA_PORCENTAJE=1
# Clave para que un cron externo despierte la revisión: POST /api/v1/tareas/seguimientos con X-Tarea-Token.
# Vacía, ese endpoint no existe (responde 404).
TAREAS_TOKEN=

# Al por mayor con Alibaba vía API.SH (https://api.sh). Cada consulta cuesta un crédito. Ver
# docs/integraciones/alibaba-apish.md. Sin clave, la sección "Al por mayor" lo dice y no consulta nada.
APISH_KEY=
APISH_CACHE_HORAS=6
APISH_DETALLES_POR_BUSQUEDA=4
APISH_CONSULTAS_POR_DIA=200
