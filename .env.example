# Copie este archivo como .env y complete los valores. El archivo .env nunca se sube al repositorio.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/marketradar
DB_USUARIO=marketradar
DB_CLAVE=cambie_esta_clave

# Modo desarrollo: muestra detalle técnico en los errores (false en producción)
MODO_DESARROLLO=true
CORS_ORIGENES=http://localhost:8080

# Administrador inicial: se crea al arrancar si no existe. La clave debe tener mayúscula,
# minúscula, número y carácter especial, y no puede contener el correo.
ADMIN_CORREO=
ADMIN_CLAVE=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Marketradar

# Tasa de respaldo (COP por dólar) y su fecha. Solo se usa si la TRM del día no se puede consultar
# y no hay ninguna guardada en la base de datos.
TASA_USD_COP=
FECHA_TASA=

# AliExpress (Open Platform, programa de afiliados). Ver docs/integraciones/aliexpress.md
ALIEXPRESS_HABILITADO=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Shopify (Global Catalog por MCP). Ver docs/integraciones/shopify.md
SHOPIFY_HABILITADO=false
SHOPIFY_TOKEN=

# Mercado Libre Colombia (OAuth). El refresh token se obtiene una vez con el flujo de autorización
# (ver docs/integraciones/mercadolibre.md). Después el backend lo renueva solo y guarda el nuevo en la base de datos
# (tabla credencial_marketplace). Para guardarlo en un archivo, ponga la ruta en MERCADOLIBRE_ARCHIVO_TOKEN.
MERCADOLIBRE_HABILITADO=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=

# Tienda de demostración: productos de ejemplo para probar sin claves de tiendas reales.
# Ver docs/integraciones/demostracion.md. Apáguela (false) cuando haya una tienda real conectada.
DEMOSTRACION_HABILITADO=true

# Asistente de IA con Claude. La clave se crea en https://console.anthropic.com (ver docs/asistente-claude.md).
# Para apagarlo: ASISTENTE_PROVEEDOR=ninguno
ASISTENTE_PROVEEDOR=claude
ASISTENTE_API_KEY=
ASISTENTE_MODELO=claude-opus-5-5
