# Copie este archivo como .env y complete los valores. El archivo .env nunca se sube al repositorio.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/marketradar
DB_USUARIO=marketradar
DB_CLAVE=cambie_esta_clave

# Modo desarrollo: muestra detalle técnico en los errores (false en producción)
MODO_DESARROLLO=true
CORS_ORIGENES=http://localhost:8080

# Moneda (COP por dólar) y fecha de la tasa
TASA_USD_COP=
FECHA_TASA=

# AliExpress (Open Platform, programa de afiliados)
ALIEXPRESS_HABILITADO=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Shopify (Catalog API o Storefront MCP: por decidir)
SHOPIFY_HABILITADO=false
SHOPIFY_TOKEN=

# Mercado Libre Colombia (OAuth)
MERCADOLIBRE_HABILITADO=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# Asistente de IA (proveedor por decidir; "ninguno" mientras tanto)
ASISTENTE_PROVEEDOR=ninguno
ASISTENTE_API_KEY=
